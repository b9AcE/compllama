#!/bin/bash
#
# compllama
#
# Version: 20261014T0940
#
# Compiles llama.cpp from source for ONE selected GPU backend, either
# CUDA (nVidia) or Vulkan (any vendor). Backends are built separately
# so that neither machine needs the other's toolchain installed.
#
# Installs to /opt/llamacpp-<backend>-YYYYMMDDTHHMM-<ref> with a /opt/llamacpp
# symlink pointing at the build currently in use. Switching between
# already-built backends is done with --activate, which repoints that
# symlink rather than recompiling.
#
# Optionally installs a llama-server systemd service and the inillama
# model-preset helper script if they are not already present.
#
# Usage: Run as a regular user who has sudo access.
#        The script will invoke sudo only where needed.
#        Run with -h or --help for usage information.
#

# ─── User-editable defaults ─────────────────────────────────────────
# These are used as suggested defaults during interactive prompts,
# or used directly when -d is specified.
# Leave DEFAULT_SERVICE_USER empty to auto-detect (uses ${USER}).
# Leave DEFAULT_SERVICE_HOST empty to auto-detect (first UP wired/wifi interface).
# Leave DEFAULT_CUDA_ARCH empty to auto-detect via nvidia-smi.
DEFAULT_SERVICE_USER=""
DEFAULT_SERVICE_PORT="11435"
DEFAULT_SERVICE_HOST=""
DEFAULT_CUDA_ARCH=""

# Local llama.cpp clone used for --offline builds. A relative path is
# resolved against the current working directory, so the default finds
# ./llamacpp-clone. Set an absolute path here to make --offline work
# the same no matter which directory the script is run from.
DEFAULT_OFFLINE_CLONE="llamacpp-clone"

# Where the source is copied to and compiled. This is a scratch tree:
# it is deleted and recreated on every run, and nothing is delivered
# from it. It is kept after a build only so that a failed compile can
# still be investigated. Relative paths resolve against the current
# working directory, as above.
DEFAULT_COMPILE_DIR="llama.cpp-compile"

# ─── Fixed paths ────────────────────────────────────────────────────
LLAMACPP_LINK="/opt/llamacpp"
SERVICE_FILE="/etc/systemd/system/llama-server.service"
INILLAMA_FILE="${HOME}/.local/bin/inillama"
# Relative to the service user's home directory. Created and extended
# by inillama, never by compllama itself.
PRESET_FILE_REL=".config/llama.cpp/inillama.ini"
LDCONF_FILE="/etc/ld.so.conf.d/llamacpp.conf"
PROFILE_FILE="/etc/profile.d/llamacpp.sh"
PERSISTENT_CONF="/etc/localllama.conf"
# Written into the files compllama creates whole (the systemd unit and
# inillama), so that --uninstall removes only files it made itself.
# The same text appears literally inside inillama's quoted heredoc;
# keep the two identical.
COMPLLAMA_MARK="# Created by compllama; removed by compllama --uninstall."
BLOC_BEGIN="# ── BEGIN bloc managed by local llama.cpp compile-script ──"
BLOC_END="# ── END bloc managed by local llama.cpp compile-script ──"

# ─── Colour helpers (ANSI) ───────────────────────────────────────────
c_red=$'\e[31m'
c_yellow=$'\e[33m'
c_green=$'\e[32m'
c_cyan=$'\e[36m'
c_bold=$'\e[1m'
c_note=$'\e[1;97m'
c_reset=$'\e[0m'

msg_info()  { printf '%s%b%s\n' "${c_cyan}"   "$*" "${c_reset}"; }
msg_ok()    { printf '%s%b%s\n' "${c_green}"   "$*" "${c_reset}"; }
msg_warn()  { printf '%s%b%s\n' "${c_yellow}"  "$*" "${c_reset}"; }
msg_error() { printf '%s%b%s\n' "${c_red}"     "$*" "${c_reset}" >&2; }
msg_fatal() { msg_error "$*"; exit 1; }
# For information the user may want to act on: a bold bright white
# "NOTE:" ahead of an otherwise ordinary info line.
msg_note()  { printf '%sNOTE:%s %s%b%s\n' "${c_note}" "${c_reset}" "${c_cyan}" "$*" "${c_reset}"; }

# ─── Help ────────────────────────────────────────────────────────────
